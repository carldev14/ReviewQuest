/**
 * Renders all questions directly onto the ST7735 screen using small font (size 1).
 */
void updateTFTDisplay() {
    tft.fillScreen(ST77XX_BLACK);
    tft.setFont(&FreeSans9pt7b); // Switches to ~10px custom font
    tft.setTextSize(1);
    
    // Advance Y cursor past header
    tft.setCursor(0, 14);

    if (questionList.empty()) {
        tft.setTextColor(ST77XX_YELLOW);
        tft.println("No questions stored.");
        tft.setFont(); // Reset to default font before returning
        return;
    }

    for (const auto &q : questionList) {
        // Stop rendering if cursor exceeds vertical screen boundaries (line height ~14px)
        if (tft.getCursorY() > tft.height() - 14) {
            tft.setTextColor(ST77XX_MAGENTA);
            tft.println("...more");
            break;
        }

        tft.setTextColor(ST77XX_CYAN);
        tft.printf("#%d: ", q.id);
        
        tft.setTextColor(ST77XX_WHITE);
        tft.println(q.text);
    }

    // Reset font to default so other drawing operations are not affected
    tft.setFont();
}
/**
 * Common HTML Head, CSS, and navigation component
 */
