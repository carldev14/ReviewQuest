    html += "<meta name='viewport' content='width=device-width, initial-scale=1'>";
    html += "<title>" + title + "</title>";
    html += "<style>";
    html += "body { font-family: system-ui, sans-serif; background: #121212; color: #e0e0e0; margin: 0; padding: 20px; }";
    html += ".container { max-width: 600px; margin: auto; }";
    html += ".nav { display: flex; gap: 8px; margin-bottom: 20px; }";
    html += ".nav a { font-size: 0.85em; padding: 6px 10px; color: #80bfff; text-decoration: none; font-weight: bold; background: #1e1e1e; border-radius: 6px; }";
    html += ".nav a.active { background: #007bff; color: #fff; }";
    html += ".card { background: #1e1e1e; padding: 20px; border-radius: 12px; margin-bottom: 20px; }";
    html += "h2 { margin-top: 0; color: #fff; }";
    html += "label { font-size: 0.9em; color: #aaa; }";
    html += "input[type='text'], select { width: 100%; padding: 10px; margin: 6px 0 16px 0; border-radius: 6px; border: 1px solid #333; background: #2a2a2a; color: #fff; box-sizing: border-box; }";
    html += ".grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }";
    html += "button { width: 100%; background: #007bff; color: white; border: none; padding: 12px; border-radius: 6px; font-weight: bold; cursor: pointer; }";
    html += ".btn-danger { background: #dc3545; width: auto; padding: 8px 16px; margin-top: 10px; }";
    html += ".q-card { background: #2a2a2a; padding: 15px; border-radius: 8px; margin-bottom: 12px; border-left: 4px solid #dc3545; }";
    html += ".options-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-top: 8px; }";
    html += ".opt { background: #1e1e1e; padding: 8px; border-radius: 4px; font-size: 0.9em; }";
    html += ".opt.correct { border: 1px solid #28a745; background: #14331a; color: #85e89d; font-weight: bold; }";
    html += "</style></head><body><div class='container'>";
    
    // NAVIGATION BAR
    html += "<div class='nav'>";
    html += "<a href='/' class='" + String(!isManagePage ? "active" : "") + "'>Add Question</a>";
    html += "<a href='/manage' class='" + String(isManagePage ? "active" : "") + "'>Manage (" + String(questionList.size()) + ")</a>";
    html += "</div>";
    
    return html;
}

/**
 * Route 1: Home Page HTML (Form Only)
 */
String buildFullPageHTML() {
    String html = getCommonHeader("ESP32 Quiz Manager", false);
    
    html += "<div class='card'>";
    html += "<h2>Add New Question</h2>";
    html += "<form method='POST' action='/add-question'>";
    html += "<label>Question Prompt</label>";
    html += "<input type='text' name='question' placeholder='e.g., What is 2 + 2?' required>";
    html += "<div class='grid'>";
    html += "<div><label>Option A</label><input type='text' name='optA' required></div>";
    html += "<div><label>Option B</label><input type='text' name='optB' required></div>";
    html += "<div><label>Option C</label><input type='text' name='optC' required></div>";
    html += "<div><label>Option D</label><input type='text' name='optD' required></div>";
    html += "</div>";
    html += "<label>Correct Answer</label>";
    html += "<select name='correctOpt' required>";
    html += "<option value='A'>Option A</option>";
    html += "<option value='B'>Option B</option>";
    html += "<option value='C'>Option C</option>";
    html += "<option value='D'>Option D</option>";
    html += "</select>";
    html += "<button type='submit'>Save Question</button>";
    html += "</form></div>";
    html += "</div></body></html>";
    return html;
}

/**
 * Route 2: Manage/Delete Page HTML
 */
String buildManagePageHTML() {
    String html = getCommonHeader("Manage Questions", true);

    html += "<div class='card'><h2>Manage Questions</h2>";
    if (questionList.empty()) {
        html += "<p style='color: #888;'>No questions available to delete.</p>";
    } else {
        for (const auto &q : questionList) {
            html += "<div class='q-card'>";
            html += "<h3>#" + String(q.id) + ": " + q.text + "</h3>";
            html += "<div class='options-grid'>";
            html += "<div class='opt " + String(q.initialCharAns == 'A' ? "correct" : "") + "'>A) " + q.optionA + "</div>";
            html += "<div class='opt " + String(q.initialCharAns == 'B' ? "correct" : "") + "'>B) " + q.optionB + "</div>";
            html += "<div class='opt " + String(q.initialCharAns == 'C' ? "correct" : "") + "'>C) " + q.optionC + "</div>";
            html += "<div class='opt " + String(q.initialCharAns == 'D' ? "correct" : "") + "'>D) " + q.optionD + "</div>";
            html += "</div>";
            html += "<form method='POST' action='/delete-question'>";
            html += "<input type='hidden' name='id' value='" + String(q.id) + "'>";
            html += "<button type='submit' class='btn-danger'>Delete Question</button>";
            html += "</form>";
            html += "</div>";
        }
    }
    html += "</div></div></body></html>";
    return html;
}

void setup() {
    Serial.begin(115200);
    delay(1000);
    Serial.flush();

    // Serial.println("\n>>> SYSTEM BOOTING <<<");

    // INIT TFT DISPLAY
    tft.initR(INITR_GREENTAB);
    tft.setRotation(1);
    updateTFTDisplay();

    // INIT ACCESS POINT
    WiFi.mode(WIFI_AP);
    WiFi.softAP(AP_SSID, AP_PASSWORD);
    IPAddress apIP = WiFi.softAPIP();

    dnsServer.start(DNS_PORT, "*", apIP);

    // Serial.println("=================================");
    // Serial.print("AP SSID: "); // Serial.println(AP_SSID);
    // Serial.print("AP IP:   "); // Serial.println(apIP);
    // Serial.println("=================================");

    // ROUTE: INDEX PAGE
    server.on("/", HTTP_GET, [](AsyncWebServerRequest *request) {
        request->send(200, "text/html", buildFullPageHTML());
    });

    // ROUTE: DEDICATED MANAGE PAGE
    server.on("/manage", HTTP_GET, [](AsyncWebServerRequest *request) {
        request->send(200, "text/html", buildManagePageHTML());
    });

    // ROUTE: POST HANDLER TO ADD QUESTION
    server.on("/add-question", HTTP_POST, [](AsyncWebServerRequest *request) {
        if (request->hasParam("question", true)) {
            Question newQ;
            newQ.id = nextQuestionId++;
            newQ.text = request->getParam("question", true)->value();
            newQ.optionA = request->getParam("optA", true)->value();
            newQ.optionB = request->getParam("optB", true)->value();
            newQ.optionC = request->getParam("optC", true)->value();
            newQ.optionD = request->getParam("optD", true)->value();
            newQ.initialCharAns = request->getParam("correctOpt", true)->value().charAt(0);

            questionList.push_back(newQ);

            printToSerial();
            updateTFTDisplay();

            request->redirect("/");
        } else {
            request->send(400, "text/plain", "Bad Request: Missing parameters.");
        }
    });

    // ROUTE: POST HANDLER TO DELETE QUESTION BY ID
    server.on("/delete-question", HTTP_POST, [](AsyncWebServerRequest *request) {
        if (request->hasParam("id", true)) {
            int deleteId = request->getParam("id", true)->value().toInt();

            auto it = std::remove_if(questionList.begin(), questionList.end(),
                [deleteId](const Question &q) { return q.id == deleteId; });

            if (it != questionList.end()) {
                questionList.erase(it, questionList.end());
                // Serial.printf("[DELETE] Removed question ID #%d\n", deleteId);
            }

            printToSerial();
            updateTFTDisplay();

            request->redirect("/manage");
        } else {
            request->send(400, "text/plain", "Bad Request: Missing ID.");
        }
    });

    server.onNotFound([](AsyncWebServerRequest *request) {
        request->redirect("/");
    });

    server.begin();
    // Serial.println("Async Web Server listening on port 80.");
}

void loop() {
    dnsServer.processNextRequest();
}